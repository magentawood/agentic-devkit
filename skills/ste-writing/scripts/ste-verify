#!/usr/bin/env python3
"""Prove that a rewrite kept what it must keep, and that every link resolves.

Usage:
  ste-verify diff BEFORE AFTER     Compare two versions of one document.
                                   Each side is a path or git:<ref>:<path>.
  ste-verify links [ROOT]          Check every link in the Markdown and HTML under ROOT.

diff fails when any of these differ between the two versions:
  links     Markdown links, wikilinks, embeds, bare URLs, href/src targets
  anchors   ^block IDs
  headings  every heading, in order
  code      inline code spans and fenced blocks
  ids       identifiers such as T-06, ADR-0012, CP2, PD3, S1
  numbers   every number, with its currency sign or percent sign

links fails on a relative link to a missing file, a missing #heading, or a
missing ^block, and on a wikilink that matches no note.
Exit code 0 means all checks passed.
"""
import html, os, re, subprocess, sys
from urllib.parse import unquote

MD_LINK = re.compile(r"!?\[(?:[^\]\\]|\\.)*\]\(\s*<?([^)\s>]+)>?(?:\s+\"[^\"]*\")?\s*\)")
WIKI = re.compile(r"!?\[\[([^\]|]+)(?:\|[^\]]*)?\]\]")
URL = re.compile(r"(?<![(<\"'])\bhttps?://[^\s)>\]\"'`]+")
HREF = re.compile(r"""(?:href|src)\s*=\s*["']([^"']+)["']""", re.I)
BLOCK = re.compile(r"(?:^|\s)\^([A-Za-z0-9-]+)\s*$", re.M)
HEADING = re.compile(r"^(#{1,6})\s+(.+?)\s*#*\s*$", re.M)
FENCE = re.compile(r"^(```+|~~~+)[^\n]*\n.*?^\1\s*$", re.M | re.S)
INLINE = re.compile(r"`[^`\n]+`")
IDS = re.compile(r"\b(?:ADR-\d{4}|[A-Z]{1,4}-\d{1,4}[a-z]?|(?:CP|PD|S|P|D|V|M|F|T|A)\d{1,3}[a-z]?)\b")
NUMBER = re.compile(r"[₹$€£]?\d(?:[\d,.:]*\d)?%?")


def read(spec):
    if spec.startswith("git:"):
        _, ref, path = spec.split(":", 2)
        return subprocess.run(["git", "show", f"{ref}:{path}"], capture_output=True, text=True, check=True).stdout
    with open(spec, encoding="utf-8") as f:
        return f.read()


def strip_frontmatter(text):
    if text.startswith("---\n"):
        end = text.find("\n---", 4)
        if end != -1:
            return text[end + 4:]
    return text


def inventory(text):
    body = strip_frontmatter(text)
    fences = FENCE.findall(body) and [m.group(0) for m in FENCE.finditer(body)]
    prose = FENCE.sub("", body)
    inline = INLINE.findall(prose)
    no_code = INLINE.sub(" ", prose)
    links = MD_LINK.findall(no_code) + WIKI.findall(no_code) + URL.findall(no_code) + HREF.findall(no_code)
    return {
        "links": set(links),
        "anchors": set(BLOCK.findall(body)),
        "headings": [h[1] for h in HEADING.findall(prose)],
        "code": set(inline) | set(fences or []),
        "ids": set(IDS.findall(no_code)),
        "numbers": set(NUMBER.findall(re.sub(r"\]\([^)]*\)|https?://\S+", " ", no_code))),
    }


def cmd_diff(before, after):
    a, b = inventory(read(before)), inventory(read(after))
    failed = False
    for key in a:
        if key == "headings":
            if a[key] != b[key]:
                failed = True
                print(f"headings: changed\n  before: {a[key]}\n  after:  {b[key]}")
            continue
        lost, new = sorted(a[key] - b[key]), sorted(b[key] - a[key])
        if lost or new:
            failed = True
            if lost:
                print(f"{key}: missing after rewrite: {lost}")
            if new:
                print(f"{key}: new after rewrite: {new}")
    print("ste-verify: FAIL" if failed else "ste-verify: PASS (links, anchors, headings, code, ids, numbers)")
    return 1 if failed else 0


# ── repo-wide link check ──────────────────────────────────────────────────
def slug(heading):
    h = re.sub(r"[`*_\[\]]", "", heading.strip().lower())
    return re.sub(r"\s", "-", re.sub(r"[^\w\s-]", "", h))


def targets(path, cache={}):
    """Headings (as text and slug) and block IDs a file defines."""
    if path not in cache:
        try:
            text = open(path, encoding="utf-8").read()
        except (OSError, UnicodeDecodeError):
            text = ""
        heads = [h[1] for h in HEADING.findall(FENCE.sub("", text))]
        cache[path] = ({h.lower() for h in heads} | {slug(h) for h in heads}
                       | set(re.findall(r'\bid="([^"]+)"', text)), set(BLOCK.findall(text)))
    return cache[path]


def cmd_links(root):
    root = os.path.abspath(root)
    files, notes = [], {}
    for d, dirs, names in os.walk(root):
        dirs[:] = [x for x in dirs if not x.startswith(".") and x != "node_modules"]
        for n in names:
            p = os.path.join(d, n)
            if n.endswith((".md", ".html")):
                files.append(p)
            notes.setdefault(os.path.splitext(n)[0].lower(), []).append(p)
            notes.setdefault(n.lower(), []).append(p)
            rel = os.path.relpath(p, root)
            notes.setdefault(os.path.splitext(rel)[0].lower(), []).append(p)
    bad = 0

    def check_anchor(target_file, anchor, where, raw):
        nonlocal bad
        if not anchor or not target_file.endswith(".md"):
            return
        heads, blocks = targets(target_file)
        ok = anchor[1:] in blocks if anchor.startswith("^") else (anchor.lower() in heads or slug(anchor) in heads)
        if not ok:
            bad += 1
            print(f"{where}: missing anchor in {os.path.relpath(target_file, root)}: {raw}")

    for f in files:
        text = open(f, encoding="utf-8", errors="replace").read()
        body = INLINE.sub(" ", FENCE.sub("", text))
        found = HREF.findall(body) if f.endswith(".html") else MD_LINK.findall(body) + HREF.findall(body)
        for raw in found:
            if re.match(r"^[a-z][a-z0-9+.-]*:", raw, re.I) or raw.startswith("//"):
                continue
            path, _, frag = unquote(html.unescape(raw)).partition("#")
            tgt = f if not path else os.path.normpath(os.path.join(os.path.dirname(f), path))
            where = os.path.relpath(f, root)
            if not os.path.exists(tgt):
                bad += 1
                print(f"{where}: missing file: {raw}")
                continue
            check_anchor(tgt, "#" + frag if frag and not frag.startswith("^") else frag, where, raw)
        if f.endswith(".md"):
            for raw in WIKI.findall(body):
                name, _, frag = raw.partition("#")
                where = os.path.relpath(f, root)
                hits = notes.get(name.strip().lower(), []) if name.strip() else [f]
                if not hits:
                    bad += 1
                    print(f"{where}: wikilink matches no note: [[{raw}]]")
                    continue
                if frag:
                    check_anchor(hits[0], frag if frag.startswith("^") else frag, where, f"[[{raw}]]")
    print(f"ste-verify: {bad} broken link(s) in {len(files)} file(s)")
    return 1 if bad else 0


def main(argv):
    if len(argv) == 3 and argv[0] == "diff":
        return cmd_diff(argv[1], argv[2])
    if argv and argv[0] == "links":
        return cmd_links(argv[1] if len(argv) > 1 else ".")
    sys.exit(__doc__)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
