#!/usr/bin/env python3
"""Tick one checkbox in a task note and link the PR that did the work.

Usage:
  tick NOTE "ITEM TEXT" PR [--url URL] [--dry-run]

NOTE is the path of the task note. ITEM TEXT is the exact text of one
checkbox, without "- [ ] ". PR is the pull request number. The script changes

  - [ ] ITEM TEXT
to
  - [x] ITEM TEXT · [#PR](URL)

URL comes from --url, else it is https://github.com/<repo>/pull/<PR>, with
"repo" from devkit.config.json. The script refuses when the text matches no
checkbox, when it matches more than one, or when the checkbox is already
ticked or dropped ("- [-]"). The generator of the plan keeps the tick because
it matches the item by its exact text.

--dry-run prints the line before and after, and does not write the file.
Exit code 1 means the script made no change.
"""
import json, os, re, subprocess, sys

CHECK_RE = re.compile(r"^(\s*)- \[([ xX-])\]\s+(.*?)\s*$")
PR_RE = re.compile(r"\s*·\s*\[#(\d+)\]\([^)]*\)\s*$")


def load(path):
    try:
        with open(os.path.expanduser(path)) as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


def config():
    """Plugin defaults, then the project file, then the user file. One level of dict merge."""
    here = os.path.dirname(os.path.abspath(__file__))
    root = subprocess.run(["git", "rev-parse", "--show-toplevel"], capture_output=True, text=True).stdout.strip() or os.getcwd()
    merged = {}
    for level in (load(os.path.join(here, "..", "..", "..", "devkit.config.json")),
                  load(os.path.join(root, "devkit.config.json")),
                  load("~/.config/agentic-devkit/config.json")):
        for key, value in level.items():
            merged[key] = {**merged.get(key, {}), **value} if isinstance(value, dict) and isinstance(merged.get(key), dict) else value
    return merged


def main(argv):
    argv = list(argv)
    dry = "--dry-run" in argv
    if dry:
        argv.remove("--dry-run")
    url = None
    if "--url" in argv:
        i = argv.index("--url")
        if i + 1 >= len(argv):
            sys.exit("tick: --url needs a value")
        url = argv[i + 1]
        del argv[i:i + 2]
    if len(argv) != 3 or not argv[2].lstrip("#").isdigit():
        sys.exit(__doc__)
    note, text, pr = argv[0], argv[1].strip(), argv[2].lstrip("#")
    if not url:
        repo = config().get("repo")
        if not repo:
            sys.exit("tick: no PR URL. Give --url or set \"repo\" in devkit.config.json.")
        url = f"https://github.com/{repo}/pull/{pr}"

    with open(note, encoding="utf-8") as f:
        lines = f.read().split("\n")
    hits = []
    for n, line in enumerate(lines):
        m = CHECK_RE.match(line)
        if m and PR_RE.sub("", m.group(3)).strip() == text:
            hits.append((n, m))
    if not hits:
        sys.exit(f"tick: no checkbox with this exact text in {note}: {text}")
    if len(hits) > 1:
        sys.exit(f"tick: {len(hits)} checkboxes have this text in {note} (lines "
                 f"{', '.join(str(n + 1) for n, _ in hits)}). Make the text unique first.")
    n, m = hits[0]
    if m.group(2) != " ":
        state = "dropped" if m.group(2) == "-" else "already ticked"
        sys.exit(f"tick: line {n + 1} is {state}: {lines[n].strip()}")

    new = f"{m.group(1)}- [x] {text} · [#{pr}]({url})"
    print(f"line {n + 1}:\n- {lines[n]}\n+ {new}")
    if dry:
        print("tick: dry run. No change made.")
        return 0
    lines[n] = new
    with open(note, "w", encoding="utf-8") as f:
        f.write("\n".join(lines))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
