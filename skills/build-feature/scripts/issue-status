#!/usr/bin/env python3
"""Set the status label of a GitHub issue and post a stage-change comment.

Usage:
  issue-status ISSUE STATUS [--claim] [--note TEXT] [--repo OWNER/NAME] [--dry-run]

ISSUE is the issue number. STATUS is one of "statusLabels" in
devkit.config.json, with or without the "status:" prefix (for example
"in-review"). The script adds that label, removes every other status:* label,
and posts one comment that names the old and the new status. --note adds one
line to the comment. The script does not touch labels without the status:
prefix, so lane and role labels stay.

--claim also assigns the issue to the gh user. If the issue has a status:*
label, the claim keeps it and ignores STATUS, so a ticket never goes back to
an earlier stage. If a different person is an assignee, the script makes no
change and exits 2.

The repo comes from --repo, else from "repo" in the project devkit.config.json.
--dry-run reads the issue, then prints the gh commands and makes no change.
Exit code 1 means a bad argument or a gh failure. Exit code 2 means the
issue is claimed by a different person.
"""
import json, os, shlex, subprocess, sys

PREFIX = "status:"


def load(path):
    try:
        with open(os.path.expanduser(path)) as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


def config():
    """Plugin defaults, then the project file, then the user file. One level of dict merge."""
    here = os.path.dirname(os.path.abspath(__file__))
    root = subprocess.run(["git", "rev-parse", "--show-toplevel"], capture_output=True, text=True).stdout.strip() or os.getcwd()
    merged = {}
    for level in (load(os.path.join(here, "..", "..", "..", "defaults", "devkit.defaults.json")),
                  load(os.path.join(root, "devkit.config.json")),
                  load("~/.config/agentic-devkit/config.json")):
        for key, value in level.items():
            merged[key] = {**merged.get(key, {}), **value} if isinstance(value, dict) and isinstance(merged.get(key), dict) else value
    return merged


def option(argv, name):
    if name not in argv:
        return None
    i = argv.index(name)
    if i + 1 >= len(argv):
        sys.exit(f"issue-status: {name} needs a value")
    value = argv[i + 1]
    del argv[i:i + 2]
    return value


def gh(args, dry):
    print("$ gh " + " ".join(shlex.quote(a) for a in args))
    if dry:
        return
    result = subprocess.run(["gh"] + args, capture_output=True, text=True)
    if result.returncode:
        sys.exit(f"issue-status: gh failed: {result.stderr.strip()}")


def main(argv):
    argv = list(argv)
    dry = "--dry-run" in argv
    if dry:
        argv.remove("--dry-run")
    claim = "--claim" in argv
    if claim:
        argv.remove("--claim")
    cfg = config()
    note = option(argv, "--note")
    repo = option(argv, "--repo") or cfg.get("repo")
    if len(argv) != 2 or not argv[0].lstrip("#").isdigit():
        sys.exit(__doc__)
    issue = argv[0].lstrip("#")
    target = argv[1] if argv[1].startswith(PREFIX) else PREFIX + argv[1]
    allowed = cfg.get("statusLabels", [])
    if target not in allowed:
        sys.exit(f"issue-status: {target} is not in statusLabels: {', '.join(allowed)}")
    if not repo:
        sys.exit("issue-status: no repo. Give --repo OWNER/NAME or set \"repo\" in devkit.config.json.")

    view = subprocess.run(["gh", "issue", "view", issue, "--repo", repo, "--json", "labels,assignees"],
                          capture_output=True, text=True)
    if view.returncode:
        sys.exit(f"issue-status: cannot read issue #{issue} in {repo}: {view.stderr.strip()}")
    data = json.loads(view.stdout)
    current = [l["name"] for l in data["labels"]]
    assign = False
    if claim:
        me = subprocess.run(["gh", "api", "user", "--jq", ".login"], capture_output=True, text=True).stdout.strip()
        if not me:
            sys.exit("issue-status: cannot read the gh user. Run gh auth status.")
        others = [a["login"] for a in data["assignees"] if a["login"] != me]
        if others:
            print(f"issue-status: #{issue} is claimed by {', '.join(others)}. No change.")
            return 2
        assign = me not in [a["login"] for a in data["assignees"]]
        held = [l for l in current if l.startswith(PREFIX)]
        if held:
            # A claim never moves a ticket back to an earlier stage.
            target = held[0]
    old = [l for l in current if l.startswith(PREFIX) and l != target]
    relabel = bool(old) or target not in current
    if not relabel and not assign:
        print(f"issue-status: #{issue} already has {target}. No change.")
        return 0

    if relabel:
        have = subprocess.run(["gh", "label", "list", "--repo", repo, "--limit", "500", "--json", "name"],
                              capture_output=True, text=True)
        if have.returncode == 0 and target not in {l["name"] for l in json.loads(have.stdout)}:
            gh(["label", "create", target, "--repo", repo, "--color", "C5DEF5",
                "--description", "Pipeline stage, set by build-feature"], dry)

    edit = ["issue", "edit", issue, "--repo", repo]
    if relabel:
        edit += ["--add-label", target]
    if old:
        edit += ["--remove-label", ",".join(old)]
    if assign:
        edit += ["--add-assignee", "@me"]
    gh(edit, dry)

    parts = []
    if relabel:
        before = ", ".join(f"`{l}`" for l in old) or "no status"
        parts.append(f"Stage change: {before} → `{target}`.")
    if assign:
        parts.append(f"Claimed by @{me} with build-feature.")
    body = " ".join(parts)
    if note:
        body += f"\n\n{note}"
    gh(["issue", "comment", issue, "--repo", repo, "--body", body], dry)

    if assign and not dry:
        again = subprocess.run(["gh", "issue", "view", issue, "--repo", repo, "--json", "assignees"],
                               capture_output=True, text=True)
        rivals = [a["login"] for a in json.loads(again.stdout or "{}").get("assignees", []) if a["login"] != me]
        if rivals:
            print(f"issue-status: {', '.join(rivals)} claimed #{issue} at the same time. Agree who takes it.")
            return 2
    if dry:
        print("issue-status: dry run. No change made.")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
